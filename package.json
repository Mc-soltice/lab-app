    "@tanstack/react-query": "^5.101.2",
    "bcrypt": "^5.1.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "ldrs": "^1.1.9",
    "lucide-react": "^1.23.0",
    "mariadb": "^3.5.3",
    "next": "15.1.0",
    "next-auth": "^4.24.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.6.0",
